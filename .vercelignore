# What ships is static: index.html, assets/, vendor/, and the SEO files
# (robots.txt, sitemap.xml, site.webmanifest). Everything else here is the
# local build + verification harness and must not reach the production domain.

node_modules/
shots/
assets/src/
.claude/

# every root-level .js is either the dev server or a test script — the only
# runtime JavaScript is assets/stations.js and the vendored libraries
/*.js

# the harness's package.json — its "main"/"start" make Vercel treat this as a
# Node server instead of a static site
package.json
package-lock.json

# internal notes
EVALUATION.md
